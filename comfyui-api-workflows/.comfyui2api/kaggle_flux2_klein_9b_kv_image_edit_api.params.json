{
  "version": 1,
  "kind": "img2img",
  "prompt_node": "135.text",
  "image_node": "76.image",
  "parameters": {
    "n": {
      "type": "int",
      "minimum": 1,
      "maximum": 16,
      "description": "Number of images / latent batch size.",
      "maps": [
        {
          "target": "129.batch_size"
        }
      ]
    },
    "steps": {
      "type": "int",
      "minimum": 1,
      "description": "Sampler steps.",
      "maps": [
        {
          "target": "137.steps"
        }
      ]
    },
    "cfg": {
      "type": "float",
      "description": "CFG / guidance scale.",
      "maps": [
        {
          "target": "138.cfg"
        }
      ]
    },
    "seed": {
      "type": "int",
      "description": "Random seed. Omit or pass -1 to randomize each job.",
      "maps": [
        {
          "target": "125.noise_seed"
        }
      ]
    },
    "image2": {
      "type": "image",
      "description": "Second input image. Filled automatically from extra OpenAI edit images.",
      "maps": [
        {
          "target": "81.image"
        }
      ]
    },
    "inputImgCount": {
      "type": "int",
      "default": 1,
      "minimum": 1,
      "description": "Number of input images. Auto-assigned from the actual edit image count; default 1 for single-image edits.",
      "maps": [
        {
          "target": "705.value"
        }
      ]
    }
  }
}
