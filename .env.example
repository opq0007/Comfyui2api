### comfyui2api .env 模板
### 用途：
### - Docker Compose：会自动读取同目录的 .env 用于变量替换
### - 本机运行：你可以手动 `set`/`$env:`，或用 `uvicorn --env-file .env ...`

### API 服务监听
API_LISTEN=0.0.0.0
API_PORT=8000

### 必填：业务接口 Authorization: Bearer <token>
API_TOKEN=change-me-api-token

### 必填：管理台 /v1/admin 与 /ui 密钥门
ADMIN_TOKEN=change-me-admin-token

### 可选：用于生成对外可访问的输出 URL（例如放在反代后面时）
PUBLIC_BASE_URL=

### 工作流目录（ComfyUI File -> Export (API) 导出的 JSON）
WORKFLOWS_DIR=./comfyui-api-workflows

### 运行产物目录（任务输出会保存在 RUNS_DIR/<job_id>/）
RUNS_DIR=./runs

### 任务历史与实例/模型配置（同一 SQLite）
DATA_DIR=./data
DATABASE_PATH=./data/comfyui2api.db

### 写入 ComfyUI input 时使用的 subfolder 名（上传走 POST /upload/image）
INPUT_SUBDIR=comfyui2api

### 已完成/失败任务的保留与清理策略
JOB_RETENTION_DAYS=
JOB_RETENTION_SECONDS=604800
MAX_JOBS_IN_MEMORY=1000
JOB_CLEANUP_INTERVAL_S=60

### 是否监听工作流目录变更并热加载
ENABLE_WORKFLOW_WATCH=true

### 请求/图片大小限制
MAX_BODY_BYTES=30000000
MAX_IMAGE_BYTES=20000000

### 执行超时/轮询参数（单位：秒）
TIMEOUT_S=3600
POLL_INTERVAL_S=0.5
HTTP_TIMEOUT_S=600

### 巡检（按实例探 /system_stats；未知不等于 healthy）
HEALTH_CHECK_INTERVAL_S=60
HEALTH_CHECK_TIMEOUT_S=5
HEALTH_CHECK_FAIL_THRESHOLD=3
HEALTH_CHECK_RECOVERY_THRESHOLD=1

### 输出媒体下载链接的短期签名
SIGNED_URL_SECRET=
SIGNED_URL_TTL_SECONDS=3600
